rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasAll(['email', 'username', 'createdAt'])
        && request.resource.data.keys().hasOnly([
          'firstName',
          'lastName',
          'email',
          'phone',
          'username',
          'age',
          'preferredCurrency',
          'idType',
          'governmentIdType',
          'governmentIdNumber',
          'investedBefore',
          'tradingAmount',
          'incomeSource',
          'riskLevel',
          'dob',
          'countryBirth',
          'emailVerified',
          'phoneVerified',
          'profilePhoto',
          'createdAt'
        ]);
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['profilePhoto'])
        && request.resource.data.profilePhoto is string
        && request.resource.data.profilePhoto.size() <= 300000;
      allow list, delete: if false;

      match /paymentMethods/{methodId} {
        function isOwner() {
          return isSignedIn() && request.auth.uid == userId;
        }

        allow get, list: if isOwner();
        allow create: if isOwner()
          && request.resource.data.keys().hasOnly([
            'type',
            'bankCountry',
            'bankName',
            'holderName',
            'accountType',
            'accountLast4',
            'routingLast4',
            'cardNetwork',
            'cardType',
            'status',
            'cardLast4',
            'expiry',
            'billingStreet',
            'billingCity',
            'billingState',
            'billingPostal',
            'billingCountry',
            'createdAt'
          ])
          && request.resource.data.keys().hasAll(['type', 'holderName', 'createdAt'])
          && request.resource.data.holderName is string
          && request.resource.data.holderName.size() <= 80
          && request.resource.data.createdAt is timestamp
          && (
            (request.resource.data.type == 'bank'
              && request.resource.data.keys().hasAll(['bankCountry', 'bankName', 'accountType', 'accountLast4', 'routingLast4'])
              && request.resource.data.bankCountry is string
              && request.resource.data.bankCountry.size() <= 80
              && request.resource.data.bankName is string
              && request.resource.data.bankName.size() <= 80
              && request.resource.data.accountType in ['Checking', 'Savings']
              && request.resource.data.accountLast4 is string
              && request.resource.data.accountLast4.size() == 4
              && request.resource.data.routingLast4 is string
              && request.resource.data.routingLast4.size() == 4)
            ||
            (request.resource.data.type == 'card'
              && request.resource.data.keys().hasAll([
                'cardNetwork',
                'cardType',
                'status',
                'cardLast4',
                'expiry',
                'billingStreet',
                'billingCity',
                'billingState',
                'billingPostal',
                'billingCountry'
              ])
              && request.resource.data.cardNetwork in ['Visa', 'Mastercard', 'American Express', 'Discover', 'Other']
              && request.resource.data.cardType in ['Credit card', 'Debit card']
              && request.resource.data.status == 'active'
              && request.resource.data.cardLast4 is string
              && request.resource.data.cardLast4.size() == 4
              && request.resource.data.expiry is string
              && request.resource.data.expiry.matches('^(0[1-9]|1[0-2])/[0-9]{2}$')
              && request.resource.data.billingStreet is string
              && request.resource.data.billingStreet.size() <= 120
              && request.resource.data.billingCity is string
              && request.resource.data.billingCity.size() <= 80
              && request.resource.data.billingState is string
              && request.resource.data.billingState.size() <= 80
              && request.resource.data.billingPostal is string
              && request.resource.data.billingPostal.size() <= 20
              && request.resource.data.billingCountry is string
              && request.resource.data.billingCountry.size() <= 80)
          );
        allow update: if isOwner()
          && resource.data.type == 'card'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['active', 'frozen'];
        allow delete: if isOwner();
      }

      match /transactions/{transactionId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['type', 'description', 'createdAt'])
          && request.resource.data.keys().hasAll(['type', 'description', 'createdAt'])
          && request.resource.data.type in [
            'bank-account-added',
            'card-added',
            'payment-method-removed',
            'card-frozen',
            'card-active',
            'account-closure-requested'
          ]
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 240
          && request.resource.data.createdAt is timestamp;
        allow update, delete: if false;
      }

      match /accountClosureRequests/{requestId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['status', 'requestedAt'])
          && request.resource.data.status == 'requested'
          && request.resource.data.requestedAt is timestamp;
        allow update, delete: if false;
      }

      match /cardRequests/{requestId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
            'material',
            'cardStyle',
            'styleId',
            'engravingText',
            'designNote',
            'designImageData',
            'status',
            'createdAt'
          ])
          && request.resource.data.keys().hasAll([
            'material',
            'cardStyle',
            'styleId',
            'engravingText',
            'designNote',
            'designImageData',
            'status',
            'createdAt'
          ])
          && (
            (request.resource.data.material == 'Metal'
              && request.resource.data.styleId == 'black-platinum'
              && request.resource.data.cardStyle == 'Black Platinum')
            || (request.resource.data.material == 'Metal'
              && request.resource.data.styleId == 'bronze-day-to-day'
              && request.resource.data.cardStyle == 'Bronze Day to Day')
            || (request.resource.data.material == 'Plastic'
              && request.resource.data.styleId == 'white-plastic-regular'
              && request.resource.data.cardStyle == 'White Regular')
          )
          && request.resource.data.engravingText is string
          && request.resource.data.engravingText.size() > 0
          && request.resource.data.engravingText.size() <= 20
          && request.resource.data.designNote is string
          && request.resource.data.designNote.size() <= 300
          && request.resource.data.designImageData is string
          && request.resource.data.designImageData.size() <= 240000
          && (request.resource.data.designImageData == ''
            || request.resource.data.designImageData.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$'))
          && request.resource.data.status == 'Submitted'
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      match /communityInbox/{messageId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
            'type',
            'subject',
            'senderUid',
            'recipientUid',
            'investorName',
            'investorType',
            'investorCompany',
            'companyName',
            'amount',
            'currency',
            'term',
            'contractFileName',
            'contractPdfDataUrl',
            'contractText',
            'createdAt'
          ])
          && request.resource.data.keys().hasAll([
            'type',
            'subject',
            'senderUid',
            'recipientUid',
            'investorName',
            'investorType',
            'companyName',
            'amount',
            'currency',
            'term',
            'contractFileName',
            'contractPdfDataUrl',
            'contractText',
            'createdAt'
          ])
          && request.resource.data.type == 'signed-investment-contract'
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.recipientUid == userId
          && request.resource.data.subject is string
          && request.resource.data.subject.size() <= 180
          && request.resource.data.investorName is string
          && request.resource.data.investorName.size() > 0
          && request.resource.data.investorName.size() <= 120
          && request.resource.data.investorType in ['Individual', 'Company']
          && (!request.resource.data.keys().hasAny(['investorCompany'])
            || request.resource.data.investorCompany == null
            || (request.resource.data.investorCompany is string
              && request.resource.data.investorCompany.size() <= 120))
          && request.resource.data.companyName is string
          && request.resource.data.companyName.size() > 0
          && request.resource.data.companyName.size() <= 160
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.currency is string
          && request.resource.data.currency.matches('^[A-Z]{3}$')
          && request.resource.data.term in ['12 months', '24 months', '36 months', '60 months']
          && request.resource.data.contractFileName is string
          && request.resource.data.contractFileName.size() <= 180
          && request.resource.data.contractPdfDataUrl is string
          && request.resource.data.contractPdfDataUrl.size() <= 800000
          && request.resource.data.contractPdfDataUrl.matches('^data:application/pdf;base64,[A-Za-z0-9+/=]+$')
          && request.resource.data.contractText is string
          && request.resource.data.contractText.size() <= 30000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /communityPosts/{postId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'authorUid',
          'authorName',
          'text',
          'mediaUrl',
          'mediaType',
          'mediaPath',
          'createdAt'
        ])
        && request.resource.data.keys().hasAll(['authorUid', 'authorName', 'text', 'createdAt'])
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000
        && (request.resource.data.text.size() > 0
          || request.resource.data.keys().hasAll(['mediaUrl', 'mediaType', 'mediaPath']))
        && (!request.resource.data.keys().hasAny(['mediaUrl', 'mediaType', 'mediaPath'])
          || (request.resource.data.keys().hasAll(['mediaUrl', 'mediaType', 'mediaPath'])
            && request.resource.data.mediaUrl is string
            && request.resource.data.mediaUrl.size() <= 2048
            && request.resource.data.mediaType in ['image', 'video']
            && request.resource.data.mediaPath is string
            && request.resource.data.mediaPath.size() <= 200
            && request.resource.data.mediaPath.matches('^community-posts/' + request.auth.uid + '/[^/]+$')))
        && request.resource.data.createdAt is timestamp;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.authorUid == request.auth.uid;

      match /comments/{commentId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.keys().hasOnly(['authorUid', 'authorName', 'text', 'createdAt'])
          && request.resource.data.keys().hasAll(['authorUid', 'authorName', 'text', 'createdAt'])
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt is timestamp;
        allow update: if false;
        allow delete: if isSignedIn()
          && (resource.data.authorUid == request.auth.uid
            || get(/databases/$(database)/documents/communityPosts/$(postId)).data.authorUid == request.auth.uid);
      }

      match /likes/{userId} {
        allow get: if isSignedIn() && request.auth.uid == userId;
        allow list: if isSignedIn();
        allow create: if isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.createdAt is timestamp;
        allow update: if false;
        allow delete: if isSignedIn()
          && (request.auth.uid == userId
            || get(/databases/$(database)/documents/communityPosts/$(postId)).data.authorUid == request.auth.uid);
      }
    }

    match /usernames/{username} {
      allow get: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow list, update, delete: if false;
    }

    match /userDirectory/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['username'])
        && request.resource.data.username == getAfter(/databases/$(database)/documents/users/$(userId)).data.username;
      allow update, delete: if false;
    }

    match /giftCardListings/{listingId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'sellerUid',
          'sellerUsername',
          'cardType',
          'faceValue',
          'askingPrice',
          'currency',
          'description',
          'imageData',
          'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'sellerUid',
          'sellerUsername',
          'cardType',
          'faceValue',
          'askingPrice',
          'currency',
          'description',
          'imageData',
          'createdAt'
        ])
        && request.resource.data.sellerUid == request.auth.uid
        && request.resource.data.sellerUsername == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username
        && request.resource.data.cardType is string
        && request.resource.data.cardType.size() > 0
        && request.resource.data.cardType.size() <= 80
        && request.resource.data.faceValue is number
        && request.resource.data.faceValue > 0
        && request.resource.data.faceValue <= 1000000
        && request.resource.data.askingPrice is number
        && request.resource.data.askingPrice > 0
        && request.resource.data.askingPrice <= 1000000
        && request.resource.data.currency == 'USD'
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 300
        && request.resource.data.imageData is string
        && request.resource.data.imageData.size() <= 250000
        && (request.resource.data.imageData == ''
          || request.resource.data.imageData.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$'))
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.sellerUid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}