{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "mobile/**",
      "server.js",
      "app.js",
      "firebase.ts",
      "package.json",
      "package-lock.json",
      "mobile-api.js",
      "*.rules",
      "files if needed/**",
      "*.log"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  }
}